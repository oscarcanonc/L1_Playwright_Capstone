  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/oscarcanonc/L1_Playwright_Capstone/issues"
  },
  "homepage": "https://github.com/oscarcanonc/L1_Playwright_Capstone#readme",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6"
  }
}
