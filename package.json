{
  "name": "l1_playwright_capstone",
  "version": "1.0.0",
  "description": "Capstone for L1 Playwright learning path",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:accessibility": "playwright test tests/accessibility.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:visual:update": "playwright test tests/visual.spec.ts --update-snapshots",
    "test:report": "playwright show-report reports/html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oscarcanonc/L1_Playwright_Capstone.git"
  },
  "keywords": [],
